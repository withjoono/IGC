{
  "name": "igc-front",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3024 --host",
    "build": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "preview": "vite preview --port 3024",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "gen:sitemap": "node scripts/generate-sitemap.mjs",
    "prerender": "react-snap",
    "deploy:firebase": "npm run build && firebase deploy --only hosting:igc"
  },
  "reactSnap": {
    "source": "dist",
    "minifyHtml": { "collapseWhitespace": false, "removeComments": false },
    "include": [
      "/promo",
      "/promo/universities",
      "/promo/universities/ghent",
      "/promo/universities/sbu",
      "/promo/universities/utah",
      "/promo/universities/gmu",
      "/promo/deadlines",
      "/promo/diagnosis",
      "/promo/english",
      "/promo/apps",
      "/promo/blog",
      "/promo/consult"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.11",
    "@tanstack/react-router": "^1.45.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.417.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@tanstack/router-vite-plugin": "^1.45.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.17.0",
    "@typescript-eslint/parser": "^7.17.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  }
}
